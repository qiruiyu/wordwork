{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wordwork",
  "version": "0.2.0",
  "identifier": "local.wordwork.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wordwork",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "wordwork DOCX 协同审稿",
    "longDescription": "面向课题组的 DOCX 协同审稿与版本管理客户端。成员继续使用 Word 或 WPS 编辑，wordwork 负责版本分发、差异审阅、合并与发布。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
