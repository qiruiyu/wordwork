# wordwork —— Windows 单机部署配置
#
# 用法：install.ps1 会把这个文件复制成 C:\ProgramData\wordwork\wordwork.env，
#       之后要改配置就改那一份，再重新运行 install.ps1 让它生效。
#
# 这个文件被两个东西读：WORDWORK_ 开头的变量由 API 读取；
# 结尾标了「只给脚本用」的那几个是安装脚本自己用的，API 不认识它们。

# ---------------------------------------------------------------- 数据位置

# 数据目录：数据库、文档对象、日志都在它下面。
WORDWORK_DATA_DIR=C:/ProgramData/wordwork

# 数据库文件。Windows 路径必须写成三个斜杠的 sqlite:///C:/... 形式；
# 写成四个斜杠（POSIX 的 sqlite:////...）会解析失败。
WORDWORK_DATABASE_URL=sqlite:///C:/ProgramData/wordwork/db/wordwork.sqlite3

# 单个文档上限（字节），默认 100 MB。
WORDWORK_MAX_UPLOAD_BYTES=104857600

# ---------------------------------------------------------------- 第一个老师账号

# 只在数据库为空、第一次启动时生效；之后改这里不会影响已有账号。
WORDWORK_BOOTSTRAP_TEACHER=teacher

# 至少 12 位，否则服务端会拒绝启动。install.ps1 会自动生成一个强随机密码并打印出来。
WORDWORK_BOOTSTRAP_PASSWORD=change-me-before-first-login

# 首次登录是否强制改密码（1 开启，0 关闭）。
WORDWORK_BOOTSTRAP_FORCE_CHANGE=1

# ---------------------------------------------------------------- 会话

# 登录有效期（天）。
WORDWORK_SESSION_DAYS=7

# ---------------------------------------------------------------- 跨域白名单

# 客户端本身（Tauri）已被内置允许，不需要在这里登记。
# 只有用浏览器调试界面时才需要放开，正式部署请保持为空。
WORDWORK_DEV_ORIGINS=
WORDWORK_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- 以下只给脚本用

# 对外地址。没有域名就填公网 IP。学生端要填 https://<这个值>:<WORDWORK_PUBLIC_PORT>
WORDWORK_PUBLIC_HOST=1.2.3.4

# 局域网 IP。学生和你在同一个 Wi-Fi 时走这个地址，Caddy 签的证书里也会带上它。
# 请在路由器上给这台机器做固定地址分配（DHCP 静态绑定），
# 否则地址一变，局域网的客户端就连不上了。
WORDWORK_LAN_HOST=192.168.1.10

# 对外端口。大陆家宽普遍封入站 80/443，所以默认用 8443。
WORDWORK_PUBLIC_PORT=8443

# API 自己监听的回环端口，不对外，也不需要防火墙放行。
WORDWORK_API_PORT=8000

# Caddy 存放内部 CA 和证书的目录。要导给学生安装的根证书就在
# <这个目录>/pki/authorities/local/root.crt
WORDWORK_CADDY_STORAGE=C:/ProgramData/wordwork/caddy
