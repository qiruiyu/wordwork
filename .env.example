# 这个文件是给 Docker / docker compose 那条部署路径用的（一台 Linux 服务器 + 域名）。
# 如果服务器就是一台常开的 Windows 台式机、也没有域名，请改看
# deploy/windows/wordwork.env.example，并按 docs/DEPLOY-WINDOWS.md 操作。

# 域名：Caddy 会为它自动申请 HTTPS 证书
WORDWORK_DOMAIN=wordwork.example.com

# 数据目录与数据库。容器内固定为 /data，本地开发由 scripts/start-dev.ps1 覆盖
WORDWORK_DATA_DIR=/data
WORDWORK_DATABASE_URL=sqlite:////data/wordwork.db
WORDWORK_MAX_UPLOAD_BYTES=104857600

# 第一个老师账号：仅在数据库为空时创建一次，之后修改无效
# 密码至少 12 位，否则服务端会拒绝启动
WORDWORK_BOOTSTRAP_TEACHER=teacher
WORDWORK_BOOTSTRAP_PASSWORD=change-me-before-first-login
# 首次登录是否强制修改密码（1 开启，0 关闭）
WORDWORK_BOOTSTRAP_FORCE_CHANGE=1

# 登录有效期（天）
WORDWORK_SESSION_DAYS=7

# 允许跨域调用接口的来源白名单。
# 生产环境请保持为空；只有本地用浏览器调试界面时才需要放开下面这行。
# 客户端本身（Tauri）不需要在这里登记，它已被内置允许。
WORDWORK_DEV_ORIGINS=
# 额外可信来源，逗号分隔，例如 https://ops.example.com
WORDWORK_ALLOWED_ORIGINS=
